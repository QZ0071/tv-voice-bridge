<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
 <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
 <application android:label="TV语音桥" android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false">
  <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <activity android:name=".ResultActivity" android:exported="true" android:noHistory="true" android:excludeFromRecents="true" android:taskAffinity="" android:launchMode="singleInstance" android:theme="@android:style/Theme.Translucent.NoTitleBar">
   <intent-filter android:priority="1000"><action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><data android:scheme="db_voice" android:host="db_launcher" android:path="/control"/></intent-filter>
  </activity>
  <service android:name=".VoiceInputService" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
   <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
   <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility"/>
  </service>
  <receiver android:name=".DeployReceiver" android:exported="true" android:permission="android.permission.DUMP">
   <intent-filter><action android:name="io.github.qz0071.tvvoicebridge.CONFIGURE"/><action android:name="io.github.qz0071.tvvoicebridge.CHOOSE_HANDLER"/></intent-filter>
  </receiver>
 </application>
</manifest>
